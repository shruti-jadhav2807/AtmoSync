# PostgreSQL connection settings for AtmoSync
# Copy to .env and fill in your local database password. Never commit .env.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=atmosync_db
PGUSER=atmosync_user
PGPASSWORD=your_password_here

# Alternatively, provide a full PostgreSQL DSN:
# DATABASE_URL=postgresql://atmosync_user:your_password_here@localhost:5432/atmosync_db

# Apache Kafka (KRaft) settings
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=sensor.readings
KAFKA_DLQ_TOPIC=sensor.readings.dlq
KAFKA_CONSUMER_GROUP=atmosync-pg-consumer

# Apache Superset settings (set strong values in local .env; never commit .env)
SUPERSET_SECRET_KEY=replace_with_strong_random_secret_key
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_FIRSTNAME=AtmoSync
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@atmosync.local
SUPERSET_ADMIN_PASSWORD=replace_with_strong_admin_password
